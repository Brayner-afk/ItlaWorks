<!DOCTYPE html>
<html lang="es" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - StudioBooker</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-dark text-light d-flex">
    
    <!-- Sidebar -->
    <nav class="sidebar d-flex flex-column flex-shrink-0 p-3 bg-dark-subtle border-end border-dark shadow-lg">
        <a asp-controller="Home" asp-action="Index" class="d-flex align-items-center mb-4 me-md-auto text-light text-decoration-none studio-brand">
            <span class="icon-mic-wrapper me-2 shadow-sm">
                <i class="bi bi-mic-fill text-dark"></i>
            </span>
            <span class="fs-4 fw-bold tracking-tight">StudioBooker</span>
        </a>
        <hr class="border-secondary opacity-25">
        <ul class="nav nav-pills flex-column mb-auto">
            <li class="nav-item">
                <a asp-controller="Home" asp-action="Index" class="nav-link text-light @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")">
                    <i class="bi bi-house-door me-2"></i> Inicio
                </a>
            </li>
            <li class="nav-item">
                <a asp-controller="Reservas" asp-action="Index" class="nav-link text-light @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reservas" ? "active" : "")">
                    <i class="bi bi-calendar3 me-2"></i> Reservas
                </a>
            </li>
            <li class="nav-item">
                <a asp-controller="Clientes" asp-action="Index" class="nav-link text-light @(ViewContext.RouteData.Values["controller"]?.ToString() == "Clientes" ? "active" : "")">
                    <i class="bi bi-people me-2"></i> Clientes
                </a>
            </li>
            <li class="nav-item">
                <a asp-controller="Cabinas" asp-action="Index" class="nav-link text-light @(ViewContext.RouteData.Values["controller"]?.ToString() == "Cabinas" ? "active" : "")">
                    <i class="bi bi-speaker me-2"></i> Cabinas
                </a>
            </li>
            <li class="nav-item">
                <a asp-controller="Equipos" asp-action="Index" class="nav-link text-light @(ViewContext.RouteData.Values["controller"]?.ToString() == "Equipos" ? "active" : "")">
                    <i class="bi bi-tools me-2"></i> Equipamiento
                </a>
            </li>
        </ul>
        <hr class="border-secondary opacity-25">
        <div class="px-2">
            <small class="text-secondary">v1.0.0 MVP</small>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="flex-grow-1 overflow-auto bg-dark">
        <div class="p-4 p-md-5">
            @RenderBody()
        </div>
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
