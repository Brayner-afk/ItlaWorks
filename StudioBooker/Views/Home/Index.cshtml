@{
    ViewData["Title"] = "Bienvenido";
}

<div class="container h-100 d-flex align-items-center justify-content-center" style="min-height: 80vh;">
    <div class="text-center p-5 shadow-lg rounded-4 bg-dark-subtle border border-warning" style="max-width: 700px;">
        <div class="icon-mic-wrapper mx-auto mb-4" style="width: 80px; height: 80px;">
            <i class="bi bi-mic-fill text-dark fs-1"></i>
        </div>
        <h1 class="display-4 fw-bold text-yellow mb-3">StudioBooker</h1>
        <p class="lead fs-3 text-light opacity-75 mb-4">
            El mejor sistema de gestión para Podcast
        </p>
        <div class="border-top border-warning opacity-25 w-50 mx-auto mb-4"></div>
        <p class="mb-5 text-light opacity-50">
            Gestiona tus cabinas, equipos y clientes de forma profesional y eficiente.
        </p>
        <div class="d-grid gap-3 d-sm-flex justify-content-sm-center">
            <a asp-controller="Reservas" asp-action="Index" class="btn btn-yellow btn-lg fw-bold px-5 py-3 shadow-sm hover-grow">
                Comenzar ahora
            </a>
        </div>
    </div>
</div>
