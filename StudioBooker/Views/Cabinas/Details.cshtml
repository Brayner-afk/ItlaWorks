@model StudioBooker.Models.Cabina
@{ ViewData["Title"] = "Detalles de la Cabina"; }

<div class="mb-4">
    <h2 class="text-yellow fw-bold">Detalles: @Model.Nombre</h2>
    <p class="text-muted">Información técnica y estado de la cabina.</p>
</div>

<div class="card bg-dark text-white border-yellow shadow">
    <div class="card-body">
        <div class="row g-4">
            <div class="col-md-6">
                <h5 class="text-yellow border-bottom-yellow pb-2">Información Básica</h5>
                <ul class="list-unstyled mt-3">
                    <li class="mb-2"><strong>Tipo:</strong> @Model.Tipo</li>
                    <li class="mb-2"><strong>Capacidad:</strong> @Model.Capacidad personas</li>
                    <li class="mb-2">
                        <strong>Estado:</strong> 
                        <span class="badge @(Model.Estado == "Disponible" ? "bg-success" : "bg-danger")">@Model.Estado</span>
                    </li>
                </ul>
            </div>
            <div class="col-md-6">
                <h5 class="text-yellow border-bottom-yellow pb-2">Equipamiento y Cualidades</h5>
                <p class="mt-3">@(Model.Cualidades ?? "No se han especificado cualidades técnicas.")</p>
            </div>
            <div class="col-12">
                <h5 class="text-yellow border-bottom-yellow pb-2">Descripción</h5>
                <p class="mt-3">@(Model.Descripcion ?? "Esta cabina no tiene una descripción detallada aún.")</p>
            </div>
        </div>

        <div class="d-flex gap-2 mt-4">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-yellow fw-bold px-4">Editar</a>
            <a asp-action="Index" class="btn btn-outline-secondary">Volver al Listado</a>
        </div>
    </div>
</div>
