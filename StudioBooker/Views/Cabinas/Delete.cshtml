@model StudioBooker.Models.Cabina
@{ ViewData["Title"] = "Eliminar Cabina"; }

<h2 class="text-danger fw-bold mb-4">¿Eliminar Cabina?</h2>

<div class="alert alert-danger bg-dark text-danger border-danger shadow-sm">
    <i class="bi bi-exclamation-octagon-fill"></i> ¡Advertencia! Eliminar esta cabina borrará también todas las reservas asociadas a ella.
</div>

<div class="card bg-dark text-white border-danger shadow">
    <div class="card-body">
        <h5 class="text-yellow border-bottom-yellow pb-2 mb-3">Confirmar datos de: @Model.Nombre</h5>
        <div class="row">
            <div class="col-md-6">
                <p><strong>Tipo:</strong> @Model.Tipo</p>
                <p><strong>Capacidad:</strong> @Model.Capacidad personas</p>
            </div>
            <div class="col-md-6">
                <p><strong>Estado Actual:</strong> @Model.Estado</p>
            </div>
        </div>

        <form asp-action="Delete" class="mt-4">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger fw-bold px-4">Eliminar Definitivamente</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        </form>
    </div>
</div>
