@model IEnumerable<StudioBooker.Models.Cabina>
@{ ViewData["Title"] = "Gestión de Cabinas"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="text-yellow fw-bold">Nuestras Cabinas</h2>
    <a asp-action="Create" class="btn btn-yellow fw-bold"><i class="bi bi-plus-circle"></i> Nueva Cabina</a>
</div>

<div class="row row-cols-1 row-cols-md-2 g-4">
    @foreach (var item in Model) {
        <div class="col">
            <div class="card bg-dark border-yellow h-100 shadow">
                <div class="card-body text-white">
                    <div class="d-flex justify-content-between align-items-start">
                        <h5 class="card-title text-yellow fw-bold">@item.Nombre</h5>
                        <span class="badge @(item.Estado == "Disponible" ? "bg-success" : "bg-danger")">@item.Estado</span>
                    </div>
                    <h6 class="card-subtitle mb-2 text-muted">@item.Tipo (Capacidad: @item.Capacidad)</h6>
                    <p class="card-text mt-3">
                        <strong>Descripción:</strong><br />
                        @(string.IsNullOrEmpty(item.Descripcion) ? "Sin descripción disponible." : item.Descripcion)
                    </p>
                    <p class="card-text">
                        <strong>Cualidades:</strong><br />
                        @(string.IsNullOrEmpty(item.Cualidades) ? "No especificadas." : item.Cualidades)
                    </p>
                </div>
                <div class="card-footer bg-transparent border-top-yellow d-flex justify-content-end gap-2">
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-yellow"><i class="bi bi-pencil"></i> Editar</a>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info"><i class="bi bi-info-circle"></i> Detalles</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i> Eliminar</a>
                </div>
            </div>
        </div>
    }
</div>
