@model StudioBooker.Models.Cabina
@{ ViewData["Title"] = "Editar Cabina"; }

<h2 class="text-yellow fw-bold mb-4">Editar Cabina: @Model.Nombre</h2>

<div class="card bg-dark text-white border-yellow shadow">
    <div class="card-body">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="Id" />
            
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Nombre" class="form-label text-yellow fw-bold">Nombre</label>
                    <input asp-for="Nombre" class="form-control bg-dark text-white border-secondary" />
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Tipo" class="form-label text-yellow fw-bold">Tipo</label>
                    <input asp-for="Tipo" class="form-control bg-dark text-white border-secondary" />
                    <span asp-validation-for="Tipo" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Capacidad" class="form-label text-yellow fw-bold">Capacidad</label>
                    <input asp-for="Capacidad" type="number" class="form-control bg-dark text-white border-secondary" />
                    <span asp-validation-for="Capacidad" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Estado" class="form-label text-yellow fw-bold">Estado</label>
                    <select asp-for="Estado" class="form-select bg-dark text-white border-secondary">
                        <option value="Disponible">Disponible</option>
                        <option value="Mantenimiento">Mantenimiento</option>
                    </select>
                    <span asp-validation-for="Estado" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Descripcion" class="form-label text-yellow fw-bold">Descripción</label>
                <textarea asp-for="Descripcion" class="form-control bg-dark text-white border-secondary" rows="3"></textarea>
                <span asp-validation-for="Descripcion" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Cualidades" class="form-label text-yellow fw-bold">Cualidades</label>
                <textarea asp-for="Cualidades" class="form-control bg-dark text-white border-secondary" rows="3"></textarea>
                <span asp-validation-for="Cualidades" class="text-danger"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-yellow fw-bold px-4">Guardar Cambios</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
