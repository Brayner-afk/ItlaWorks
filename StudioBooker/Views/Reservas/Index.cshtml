@model IEnumerable<StudioBooker.Models.Reserva>
@{ ViewData["Title"] = "Gestión de Reservas"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="text-yellow fw-bold">Panel de Reservas</h2>
    <a asp-action="Create" class="btn btn-yellow fw-bold"><i class="bi bi-plus-circle"></i> Nueva Reserva</a>
</div>

<div class="card bg-dark-subtle border-0 shadow">
    <div class="card-body p-0">
        <table class="table table-dark table-hover mb-0">
            <thead class="table-border-yellow">
                <tr>
                    <th>Cliente</th>
                    <th>Cabina</th>
                    <th>Inicio</th>
                    <th>Fin</th>
                    <th>Costo</th>
                    <th>Estado</th>
                    <th>Motivo</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model) {
                    <tr>
                        <td>@item.Cliente?.Nombre</td>
                        <td>@item.Cabina?.Nombre</td>
                        <td>@item.FechaInicio.ToString("g")</td>
                        <td>@item.FechaFin.ToString("g")</td>
                        <td class="text-yellow fw-bold">@item.PrecioTotal.ToString("C", new System.Globalization.CultureInfo("en-US"))</td>
                        <td>
                            <span class="badge @(item.Estado == "Confirmada" ? "bg-success" : (item.Estado == "Pendiente" ? "bg-warning text-dark" : "bg-danger"))">
                                @item.Estado
                            </span>
                        </td>
                        <td class="small text-muted">@item.Motivo</td>
                        <td class="text-end">
                            @if (item.Estado == "Pendiente") {
                                <a asp-action="Confirmar" asp-route-id="@item.Id" class="btn btn-sm btn-success" title="Confirmar"><i class="bi bi-check-lg"></i></a>
                                <a asp-action="Cancelar" asp-route-id="@item.Id" class="btn btn-sm btn-danger" title="Cancelar"><i class="bi bi-x-lg"></i></a>
                            }
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-yellow"><i class="bi bi-pencil"></i></a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
