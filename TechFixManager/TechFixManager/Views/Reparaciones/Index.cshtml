@model IEnumerable<TechFixManager.Models.Reparacion>

@{
    ViewData["Title"] = "Reparaciones";
}

<h2 class="mb-3">Reparaciones</h2>

<div class="alert alert-success d-flex justify-content-between align-items-center">
    <span> Gestión de reparaciones registradas</span>
    <a asp-action="Create" class="btn btn-success">
        + Registrar Reparación
    </a>
</div>

<table class="table table-hover table-bordered align-middle">
    <thead class="table-dark">
        <tr>
            <th>Fecha</th>
            <th>Cliente</th>
            <th>Equipo</th>
            <th>Técnico</th>
            <th>Descripción</th>
            <th>Costo</th>
            <th style="width:180px;">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Fecha.ToShortDateString()</td>
                <td>@item.Equipo?.Cliente?.Nombre</td>
                <td>@item.Equipo?.Marca @item.Equipo?.Modelo</td>
                <td>@item.Tecnico?.Nombre</td>
                <td>@item.Descripcion</td>
                <td class="fw-bold text-success">RD$ @item.Costo.ToString("N2")</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">Ver</a>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Editar</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>