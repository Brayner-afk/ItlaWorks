@model TechFixManager.Models.Reparacion

@{
    ViewData["Title"] = "Registrar Reparación";
}

<h2 class="mb-3">Registrar Reparación</h2>

<div class="card shadow">
    <div class="card-body">
        <form asp-action="Create" method="post">

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="Fecha" class="form-label"></label>
                    <input asp-for="Fecha" type="date" class="form-control" />
                </div>

                <div class="col-md-4 mb-3">
                    <label class="form-label">Equipo</label>
                    <select asp-for="EquipoId" class="form-select" asp-items="ViewBag.EquipoId">
                        <option value="">-- Seleccione equipo --</option>
                    </select>
                </div>

                <div class="col-md-4 mb-3">
                    <label class="form-label">Técnico</label>
                    <select asp-for="TecnicoId" class="form-select" asp-items="ViewBag.TecnicoId">
                        <option value="">-- Seleccione técnico --</option>
                    </select>
                </div>

                <div class="col-md-8 mb-3">
                    <label asp-for="Descripcion" class="form-label"></label>
                    <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
                </div>

                <div class="col-md-4 mb-3">
                    <label class="form-label">Costo</label>
                    <div class="input-group">
                        <span class="input-group-text">RD$</span>
                        <input asp-for="Costo" type="number" step="1" min="0" class="form-control" />
                        <span class="input-group-text">.00</span>
                    </div>
                </div>
            </div>

            <button type="submit" class="btn btn-success">Guardar</button>
            <a asp-action="Index" class="btn btn-secondary">Volver</a>

        </form>
    </div>
</div>