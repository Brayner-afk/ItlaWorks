@model TechFixManager.Models.Reparacion

<h2>Editar Reparación</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />

    <div class="form-group">
        <label>Fecha</label>
        <input asp-for="Fecha" type="date" class="form-control" />
    </div>

    <div class="form-group">
        <label>Equipo</label>
        <select asp-for="EquipoId" asp-items="ViewBag.EquipoId" class="form-control"></select>
    </div>

    <div class="form-group">
        <label>Técnico</label>
        <select asp-for="TecnicoId" asp-items="ViewBag.TecnicoId" class="form-control"></select>
    </div>

    <div class="form-group">
        <label>Descripción</label>
        <textarea asp-for="Descripcion" class="form-control"></textarea>
    </div>

    <div class="form-group">
        <label>Costo</label>
        <input asp-for="Costo" class="form-control" />
    </div>

    <br />
    <button type="submit" class="btn btn-primary">Guardar cambios</button>
</form>
