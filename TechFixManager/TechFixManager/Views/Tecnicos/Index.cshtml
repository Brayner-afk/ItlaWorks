@model IEnumerable<TechFixManager.Models.Tecnico>

@{
    ViewData["Title"] = "Técnicos";
}

<h1 class="mb-3">Técnicos</h1>

<!-- Recuadro verde -->
<div class="alert alert-success d-flex justify-content-between align-items-center">
    <span> Técnicos registrados en el sistema</span>
    <a asp-action="Create" class="btn btn-success">
        + Registrar Técnico
    </a>
</div>

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>Nombre</th>
            <th>Especialidad</th>
            <th class="text-center">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Nombre</td>
                <td>@item.Especialidad</td>
                <td class="text-center">
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Editar</a>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">Ver</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>