@model TechFixManager.Models.Tecnico

@{
    ViewData["Title"] = "Registrar Técnico";
}

<h1>Registrar Técnico</h1>

<hr />

<form asp-action="Create">
    <div class="mb-3">
        <label asp-for="Nombre" class="form-label"></label>
        <input asp-for="Nombre" class="form-control" />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Especialidad" class="form-label"></label>
        <input asp-for="Especialidad" class="form-control" />
        <span asp-validation-for="Especialidad" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success"> Guardar</button>
    <a asp-action="Index" class="btn btn-secondary"> Volver</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}