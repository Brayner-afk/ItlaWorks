@model TechFixManager.Models.Equipo
@{
    ViewData["Title"] = "Detalles del Equipo";
}

<h2>Detalles del Equipo</h2>

<div class="card mb-3">
    <div class="card-body">
        <h5 class="card-title">@Model.Marca - @Model.Modelo</h5>
        <p class="card-text"><strong>Serie:</strong> @Model.Serie</p>
        <p class="card-text"><strong>Cliente:</strong> @Model.Cliente.Nombre</p>
    </div>
</div>

<a class="btn btn-primary me-1" asp-action="Edit" asp-route-id="@Model.Id">Editar</a>
<a class="btn btn-danger me-1" asp-action="Delete" asp-route-id="@Model.Id">Eliminar</a>
<a class="btn btn-secondary" asp-action="Index">Volver</a>