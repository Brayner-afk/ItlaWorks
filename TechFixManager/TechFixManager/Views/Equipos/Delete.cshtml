@model TechFixManager.Models.Equipo
@{
    ViewData["Title"] = "Eliminar Equipo";
}

<h2>Eliminar Equipo</h2>

<div class="alert alert-danger" role="alert">
    ¿Está seguro que desea eliminar este equipo?
</div>

<div class="card mb-3">
    <div class="card-body">
        <h5 class="card-title">@Model.Marca - @Model.Modelo</h5>
        <p class="card-text"><strong>Serie:</strong> @Model.Serie</p>
        <p class="card-text"><strong>Cliente:</strong> @Model.Cliente.Nombre</p>
    </div>
</div>

<form asp-action="DeleteConfirmed" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a class="btn btn-secondary" asp-action="Index">Cancelar</a>
</form>