@model IEnumerable<TechFixManager.Models.Equipo>

@{
    ViewData["Title"] = "Equipos";
}

<h1 class="mb-3">Equipos</h1>

<div class="alert alert-success d-flex justify-content-between align-items-center">
    <span> Equipos registrados</span>
    <a asp-action="Create" class="btn btn-success">+ Registrar Equipo</a>
</div>

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>Marca</th>
            <th>Modelo</th>
            <th>Serie</th>
            <th>Cliente</th>
            <th class="text-center">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Marca</td>
                <td>@item.Modelo</td>
                <td>@item.Serie</td>
                <td>@item.Cliente?.Nombre</td>
                <td class="text-center">
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Editar</a>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">Ver</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>