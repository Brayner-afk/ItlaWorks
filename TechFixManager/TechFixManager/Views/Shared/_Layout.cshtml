<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TechFixManager</title>

 
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TechFixManager.styles.css" asp-append-version="true" />
</head>
<body>

    <header>
        <nav class="navbar navbar-expand-sm navbar-dark tech-navbar shadow">
            <div class="container-fluid">

                <a class="navbar-brand d-flex align-items-center"
                   asp-controller="Home" asp-action="Index">
                    <img src="~/images/TechFixManager-Text.png"
                         alt="TechFixManager Logo"
                         style="height:40px; margin-right:10px;" />
                    <strong>TechFixManager</strong>
                </a>

                <button class="navbar-toggler" type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Inicio</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Clientes" asp-action="Index">Clientes</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Tecnicos" asp-action="Index">Técnicos</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Equipos" asp-action="Index">Equipos</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Reparaciones" asp-action="Index">Reparaciones</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Repuestos" asp-action="Index">Repuestos</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Pagos" asp-action="Index">Pagos</a></li>
                    </ul>
                </div>

            </div>
        </nav>
    </header>

    <div class="tech-banner text-center text-white py-3">
        <h4 class="mb-1">Ofrecemos el mejor servicio en cuanto a eficiencia tecnológica</h4>
        <small>Analizar • Solucionar • Optimizar</small>
    </div>

    <div class="container mt-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted mt-5">
        <div class="container text-center">
            &copy; 2025 - TechFixManager
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
