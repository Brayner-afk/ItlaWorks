@model IEnumerable<TechFixManager.Models.Pago>

<h2>Pagos</h2>

<div class="alert alert-success d-flex justify-content-between align-items-center">
    <span> Historial de pagos</span>
    <a asp-action="Create" class="btn btn-success">+ Registrar Pago</a>
</div>

<table class="table table-bordered table-hover">
    <thead class="table-dark">
        <tr>
            <th>Fecha</th>
            <th>Concepto</th>
            <th>Cantidad</th>
            <th>Monto</th>
            <th style="width:150px;">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.FechaPago.ToShortDateString()</td>
                <td>@item.Concepto</td>
                <td>@item.Cantidad</td>
                <td class="fw-bold text-success">RD$ @item.Monto.ToString("N2")</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">Ver</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>