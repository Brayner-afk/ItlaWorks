@model TechFixManager.Models.Repuesto

@{
    ViewData["Title"] = "Eliminar Repuesto";
}

<h2>Eliminar Repuesto</h2>

<div class="alert alert-danger">
    ¿Estás seguro de que deseas eliminar este repuesto?
</div>

<div class="card shadow">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-4">Nombre</dt>
            <dd class="col-sm-8">@Model.Nombre</dd>

            <dt class="col-sm-4">Cantidad</dt>
            <dd class="col-sm-8">@Model.Cantidad</dd>

            <dt class="col-sm-4">Precio</dt>
            <dd class="col-sm-8">
                RD$ @Model.Precio.ToString("N2")
            </dd>
        </dl>

        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">Eliminar</button>
            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>
</div>