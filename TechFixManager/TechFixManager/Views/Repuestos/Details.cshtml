@model TechFixManager.Models.Repuesto

@{
    ViewData["Title"] = "Detalle del Repuesto";
}

<h2>Detalle del Repuesto</h2>

<div class="card shadow">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-4">Nombre</dt>
            <dd class="col-sm-8">@Model.Nombre</dd>

            <dt class="col-sm-4">Descripción</dt>
            <dd class="col-sm-8">@Model.Descripcion</dd>

            <dt class="col-sm-4">Cantidad disponible</dt>
            <dd class="col-sm-8">@Model.Cantidad</dd>

            <dt class="col-sm-4">Precio</dt>
            <dd class="col-sm-8 fw-bold text-success">
                RD$ @Model.Precio.ToString("N2")
            </dd>
        </dl>

        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Editar</a>
        <a asp-action="Index" class="btn btn-secondary">Volver</a>
    </div>
</div>
