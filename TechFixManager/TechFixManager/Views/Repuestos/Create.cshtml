@model TechFixManager.Models.Repuesto

<h2>Registrar Repuesto</h2>

<form asp-action="Create">
    <div class="mb-3">
        <label asp-for="Nombre" class="form-label"></label>
        <input asp-for="Nombre" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Descripcion" class="form-label"></label>
        <textarea asp-for="Descripcion" class="form-control"></textarea>
    </div>

    <div class="mb-3">
        <label asp-for="Cantidad" class="form-label"></label>
        <input asp-for="Cantidad" type="number" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Precio</label>
        <div class="input-group">
            <span class="input-group-text">RD$</span>
            <input asp-for="Precio" type="number" class="form-control" />
            <span class="input-group-text">.00</span>
        </div>
    </div>

    <button type="submit" class="btn btn-success">Guardar</button>
    <a asp-action="Index" class="btn btn-secondary">Volver</a>
</form>